{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    ["@semantic-release/npm", { "npmPublish": false, "pkgRoot": "npm" }],
    ["@semantic-release/exec", { "prepareCmd": "node tools/prepare-release.mjs ${nextRelease.version}" }],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "package.json", "npm/package.json"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    ["@semantic-release/github", { "assets": ["dist/*.tar.gz", "dist/checksums.txt"] }]
  ]
}